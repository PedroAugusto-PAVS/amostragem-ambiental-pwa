{
	"appId": "br.com.pavs.hydrotrack",
	"appName": "HydroTrack",
	"webDir": "public",
	"server": {
		"androidScheme": "https"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1800,
			"launchAutoHide": true,
			"launchFadeOutDuration": 300,
			"backgroundColor": "#075664",
			"showSpinner": false,
			"androidScaleType": "CENTER_CROP",
			"androidSplashResourceName": "splash",
			"splashFullScreen": true,
			"splashImmersive": true
		},
		"StatusBar": {
			"style": "LIGHT",
			"backgroundColor": "#075664",
			"overlaysWebView": false
		},
		"Keyboard": {
			"resize": "body",
			"style": "default"
		}
	}
}
