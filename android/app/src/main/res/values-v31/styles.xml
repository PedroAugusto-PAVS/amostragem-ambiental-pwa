<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Android 12+ always renders a system launch frame. Keep it unbranded and
      aligned with the HTML splash so the HTML remains the only visible splash.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:windowSplashScreenBackground">#075664</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>

</resources>
